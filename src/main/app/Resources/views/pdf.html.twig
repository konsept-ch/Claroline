<!DOCTYPE html>

<html lang="{{ app.request.locale }}" class="claroline-app {{ config.getParameter('theme') }}">
    <head>
        <meta charset="utf-8" />

        {# This is required in order to DOMPDF manage correctly relative path (mostly for tinyMce contents) #}
        <base href="{{ baseUrl ~ '/' }}" />

        {#
            Keep PDF styles self-contained. Loading Bootstrap imports Font
            Awesome webfonts, which Dompdf may fail to cache on Windows and
            turns the PDF response into a 500 error.
        #}
    </head>

    <body>
        {{ content | raw }}
    </body>
</html>
